{
  "name": "auto-essay",
  "version": "0.1.0",
  "description": "Moteur essayistique - Agent de rédaction d'essais avec pipeline itératif",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:demo": "tsc -p tsconfig.demo.json",
    "prepare:demo-runtime": "node -e \"const fs=require('fs');fs.mkdirSync('.demo-dist',{recursive:true});fs.writeFileSync('.demo-dist/package.json',JSON.stringify({type:'commonjs'}))\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests",
    "demo:synthetic": "npm run build:demo && npm run prepare:demo-runtime && node .demo-dist/demo/runSyntheticDemo.js",
    "demo:station-reverse": "npm run build:demo && npm run prepare:demo-runtime && node .demo-dist/demo/runStationReverseDemo.js"
  },
  "dependencies": {
    "js-yaml": "^5.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "eslint": "^9.17.0",
    "globals": "^17.11.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^1.1.0"
  }
}
