{
  "name": "@auto-essay/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=forks",
    "diffract": "tsx src/diffract/cli.ts",
    "diffract-batch": "tsx src/diffract/batchCli.ts",
    "diffract-plan": "tsx src/diffract/planCli.ts",
    "draft-plan": "tsx src/diffract/draftCli.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@auto-essay/core": "*",
    "@hono/node-server": "^1.13.8",
    "hono": "^4.7.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
